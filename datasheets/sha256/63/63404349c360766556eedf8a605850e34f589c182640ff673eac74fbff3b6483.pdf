         <pdf:Producer>Acrobat Distiller 21.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">TLV431A - Low Voltage Precision Adjustable Shunt Regulator</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The TLV431A, B and C series are precision low voltage shunt&#xA;regulators that are programmable over a wide voltage range of 1.24 V to&#xA;16 V. The TLV431A series features a guaranteed reference accuracy of&#xA;Â±1.0% at 25Â°C and Â±2.0% over the entire industrial temperature range of&#xA;âˆ’40Â°C to 85Â°C. The TLV431B series features higher reference accuracy&#xA;of Â±0.5% and Â±1.0% respectively. For the TLV431C series, the accuracy&#xA;is even higher. It is Â±0.2% and Â±1.0% respectively. These devices exhibit&#xA;a sharp low current turnâˆ’on characteristic with a low dynamic impedance&#xA;of 0.20   over an operating current range of 100  A to 20 mA. This&#xA;combination of features makes this series an excellent replacement for&#xA;zener diodes in numerous applications circuits that require a precise&#xA;reference voltage.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:bf1ef0c4-9622-4664-bd50-c1c9aaf9db86</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:2dca01ea-4179-4176-96f5-0b7bce7c1d15</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
